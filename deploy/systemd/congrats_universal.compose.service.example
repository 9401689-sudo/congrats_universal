[Unit]
Description=Congrats Universal Docker Compose Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/congrats_universal
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.server.yml up -d --build
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.server.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
