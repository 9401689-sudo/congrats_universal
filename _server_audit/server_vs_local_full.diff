-    cached = IMAGE_CACHE.get(path)
-    if cached is not None:
-        return cached.copy()
-
-    data = read_bytes_retry(path)
-    im = Image.open(io.BytesIO(data))
-    im.load()
-    im = im.convert("RGBA")
