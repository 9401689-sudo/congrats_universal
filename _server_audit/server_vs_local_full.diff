-    cr, cg, cb = color
-
-    def lut(c):
-        return [int((v / 255.0) * c) for v in range(256)]
-
-    rr = gray.point(lut(cr))
-    gg = gray.point(lut(cg))
-    bb = gray.point(lut(cb))
-    return Image.merge("RGBA", (rr, gg, bb, a))
