---# ---------------------------
---# CACHES / SPEEDUPS
---# ---------------------------
---IMAGE_CACHE: Dict[str, Image.Image] = {}
---FONT_CACHE: Dict[str, ImageFont.FreeTypeFont] = {}
---PRELOADED_ASSETS: Dict[str, Image.Image] = {}
