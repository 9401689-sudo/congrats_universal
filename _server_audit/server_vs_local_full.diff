-        "jsCode": "// SAFE SESSION PARSER (handles: object | JSON string | double-encoded JSON string)\nconst raw =\n  $json.session ??\n  $json.redis?.session ??\n  $json.redis?.data ??\n  $json.data ??\n  null;\n\nlet sess = {};\n\ntry {\n  // 1) first parse (may return object OR string)\n  let parsed = raw;\n\n  if (typeof parsed === \"string\") {\n    parsed = JSON.parse(parsed);\n  }\n\n  // 2) if still string => second parse (double-encoded)\n  if (typeof parsed === \"string\") {\n    parsed = JSON.parse(parsed);\n  }\n\n  // 3) only accept objects\n  if (parsed && typeof parsed === \"object\" && !Array.isArray(parsed)) {\n    sess = parsed;\n  }\n} catch (e) {\n  sess = {};\n}\n\n// гарантируем структуру, чтобы дальше ничего не отваливалось\nsess.active_request_id = sess.active_request_id ?? null;\nsess.awaiting = sess.awaiting ?? \"none\";\nsess.current_variant_idx = sess.current_variant_idx ?? \"0\";\nsess.last_variant_idx = sess.last_variant_idx ?? \"0\";\nsess.recipient_name = sess.recipient_name ?? null;\nsess.last_inline_message_id = sess.last_inline_message_id ?? null;\n\nreturn [{\n  json: {\n    ...$json,\n    session: sess,\n    active_request_id: sess.active_request_id ? String(sess.active_request_id) : null,\n    awaiting: String(sess.awaiting || \"none\"),\n    current_variant_idx: Number(sess.current_variant_idx || 0),\n    last_variant_idx: Number(sess.last_variant_idx || 0),\n  }\n}];"
