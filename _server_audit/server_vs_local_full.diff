-export function parseCallbackData(raw: string): CallbackCommand {
-  if (raw === "START_NEW") return { kind: "start_new" };
-  if (raw === "START_FORCE_NEW") return { kind: "start_force_new" };
-  if (raw === "START_CONTINUE") return { kind: "start_continue" };
