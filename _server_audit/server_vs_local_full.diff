-
-  return {
-    botRuntimes,
-    databaseUrl: parsed.DATABASE_URL,
-    defaultBotId: parsed.DEFAULT_BOT_ID,
-    host: parsed.HOST,
-    nodeEnv: parsed.NODE_ENV,
-    port: parsed.PORT,
