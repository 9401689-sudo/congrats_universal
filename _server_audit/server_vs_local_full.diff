-  ): void {
-    if (!messageId) {
-      return;
-    }
-
-    if (hasInlineKeyboard) {
-      this.lastInlineMessageIdByChat.set(chatId, messageId);
-      return;
-    }
-
-    this.lastInlineMessageIdByChat.delete(chatId);
-  }
-}
