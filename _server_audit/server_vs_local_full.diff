-def read_bytes_retry(path: str, attempts: int = 4) -> bytes:
-    """
-    Быстрее исходной версии, но всё ещё достаточно устойчиво для rclone/WebDAV.
-    """
-    last = None
-    for i in range(attempts):
-        try:
-            with open(path, "rb") as f:
-                return f.read()
-        except OSError as e:
-            last = e
-            time.sleep(0.05 * (2 ** i))
-    raise last  # type: ignore
