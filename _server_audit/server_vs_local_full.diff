-    pythonRendererTemplatesDir: parsed.PYTHON_RENDERER_TEMPLATES_DIR,
-    redisUrl: parsed.REDIS_URL,
-    renderOutputDir: parsed.RENDER_OUTPUT_DIR
-  };
-}
