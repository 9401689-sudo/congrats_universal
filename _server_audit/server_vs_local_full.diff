nding = session.tariff_pending ?? null;\n\nsession.current_variant_idx = String(session.current_variant_idx ?? \"0\");\nsession.last_variant_idx = String(session.last_variant_idx ?? \"0\");\nsession.recipient_name = session.recipient_name ?? null;\n\nsession.initiator_timezone = session.initiator_timezone ?? null;\nsession.tz_return_to = session.tz_return_to ?? null;\n\n// 5) debug\nsession.last_update_id = update.update_id ?? session.last_update_id ?? null;\nsession.last_event_type = update.event_type ?? session.last_event_type ?? null;\nsession.last_callback_data = update.callback_data ?? session.last_callback_data ?? null;\n\nreturn [{ json: { ...update, session } }];"
