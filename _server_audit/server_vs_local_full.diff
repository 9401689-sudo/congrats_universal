-        "jsCode": "// В production Webhook данные лежат в $json.body\nconst update = $json.body ?? $json;\n\nif (!update) {\n  throw new Error(\"No update payload\");\n}\n\n// Возможные типы апдейтов\nconst message = update.message ?? null;\nconst editedMessage = update.edited_message ?? null;\nconst callback = update.callback_query ?? null;\nconst preCheckout = update.pre_checkout_query ?? null;\nconst myChatMember = update.my_chat_member ?? null;\nconst chatMember = update.chat_member ?? null;\n\nconst successfulPayment = message?.successful_payment ?? null;\n\n// Унифицированный пользователь\nconst from =\n  callback?.from ??\n  message?.from ??\n  editedMessage?.from ??\n  preCheckout?.from ??\n  myChatMember?.from ??\n  chatMember?.from ??\n  null;\n\n// Унифицированный chat\nconst chat =\n  message?.chat ??\n  editedMessage?.chat ??\n  callback?.message?.chat ??\n  myChatMember?.chat ??\n  chatMember?.chat ??\n  null;\n\nconst chatId = chat?.id ?? null;\nconst chatType = chat?.type ?? null;\n\nconst text =\n  message?.text ??\n  editedMessage?.text ??\n  null;\n\nconst isStart =\n  typeof text === \"string\" &&\n  (text === \"/start\" || text.startsWith(\"/start \"));\n\n// Определяем тип события\nlet eventType = \"unknown\";\n\nif (callback) {\n  eventType = \"callback\";\n} else if (preCheckout) {\n  eventType = \"pre_checkout\";\n} else if (successfulPayment) {\n  eventType = \"successful_payment\";\n} else if (text) {\n  eventType = \"text\";\n} else if (myChatMember) {\n  eventType = \"my_chat_member\";\n} else if (chatMember) {\n  eventType = \"chat_member\";\n}\n\n// Платёжные поля\nconst invoicePayload =\n  preCheckout?.invoice_payload ??\n  successfulPayment?.invoice_payload ??\n  null;\n\nconst totalAmount =\n  preCheckout?.total_amount ??\n  successfulPayment?.total_amount ??\n  null;\n\nconst currency =\n  preCheckout?.currency ??\n  successfulPayment?.currency ??\n  null;\n\nconst telegramPaymentChargeId =\n  successfulPayment?.telegram_payment_charge_id ?? null;\n\nconst providerPaymentChargeId =\n  successfulPayment?.provider_payment_charge_id ?? null;\n\n// Поля membership update\nconst oldMemberStatus =\n  myChatMember?.old_chat_member?.status ??\n  chatMember?.old_chat_member?.status ??\n  null;\n\nconst newMemberStatus =\n  myChatMember?.new_chat_member?.status ??\n  chatMember?.new_chat_member?.status ??\n  null;\n\nconst botBlocked =\n  eventType === \"my_chat_member\" &&\n  newMemberStatus === \"kicked\";\n\nconst botUnblocked =\n  eventType === \"my_chat_member\" &&\n  (\n    (oldMemberStatus === \"kicked\" && newMemberStatus === \"member\") ||\n    (oldMemberStatus === \"kicked\" && newMemberStatus === \"administrator\")\n  );\n\nreturn [\n  {\n    json: {\n      update_id: update.update_id ?? null,\n      event_type: eventType,\n\n      tg_user_id: from?.id ?? null,\n      tg_username: from?.username ?? null,\n      tg_first_name: from?.first_name ?? null,\n      tg_last_name: from?.last_name ?? null,\n\n      chat_id: chatId,\n      chat_type: chatType,\n\n      text,\n      is_start: isStart,\n\n      callback_data: callback?.data ?? null,\n      callback_query_id: callback?.id ?? null,\n      callback_message_id: callback?.message?.message_id ?? null,\n\n      pre_checkout_query_id: preCheckout?.id ?? null,\n\n      invoice_payload: invoicePayload,\n      total_amount: totalAmount,\n      currency,\n\n      telegram_payment_charge_id: telegramPaymentChargeId,\n      provider_payment_charge_id: providerPaymentChargeId,\n\n      old_member_status: oldMemberStatus,\n      new_member_status: newMemberStatus,\n      bot_blocked: botBlocked,\n      bot_unblocked: botUnblocked,\n\n      successful_payment: successfulPayment ?? null,\n      raw: update\n    }\n  }\n];"
