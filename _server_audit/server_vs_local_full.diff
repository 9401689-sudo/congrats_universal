++) h = (h * 31 + str.charCodeAt(i)) >>> 0;\n  return h;\n}\n\nfunction pickDeterministic(arr, seedStr) {\n  if (!arr || !arr.length) throw new Error(\"pickDeterministic: empty array\");\n  const h = simpleHash(seedStr);\n  return arr[h % arr.length];\n}\n\nfunction pickTemplateId(requestId, idx) {\n  const keys = Object.keys(TEMPLATE_REGISTRY);\n  return pickDeterministic(keys, `${requestId}:tpl:${idx}`);\n}\n\nfunction shuffleDeterministic(arr, seedStr) {\n  const a = [...arr];\n  let h = simpleHash(seedStr);\n  for (let i = a.length - 1; i > 0; i--) {\n    const j = h % (i + 1);\n    [a[i], a[j]] = [a[j], a[i]];\n    h = (h * 1103515245 + 12345) >>> 0;\n  }\n  return a;\n}\n\nfunction sampleDeterministic(arr, seedStr, n) {\n  if (!arr || !arr.length) return [];\n  const shuffled = shuffleDeterministic(arr, seedStr);\n  return shuffled.slice(0, Math.min(n, shuffled.length));\n}\n\nfunction uniqueNonEmpty(arr) {\n  const seen = new Set();\n  const out = [];\n  for (const item of (arr || [])) {\n    const s = String(item ?? \"\").trim();\n    if (!s) continue;\n    if (seen.has(s)) continue;\n    seen.add(s);\n    out.push(s);\n  }\n  return out;\n}\n\nfunction buildPointsPool(phrasesDb, category) {\n  const universal = Array.isArray(phrasesDb?.points?.universal) ? phrasesDb.points.universal : [];\n  const categoryPool = (phrasesDb?.points && Array.isArray(phrasesDb.points[category]))\n    ? phrasesDb.points[category]\n    : [];\n\n  // Если категория universal — не дублируем universal дважды\n  if (category === \"universal\") {\n    return uniqueNonEmpty(universal);\n  }\n\n  // Сначала категорийные фразы, потом добивка universal\n  return uniqueNonEmpty([...categoryPool, ...universal]);\n}\n\n// ====== INPUTS ======\nconst session = $node[\"FN_PARSE_SESSION\"]?.json?.session ?? $json.session ?? {};\nconst reqNode = $node[\"PG_GET_REQUEST\"]?.json ?? {};\nconst req = reqNode.request ?? reqNode;\nconst phrasesDb = $node[\"FN_PARSE_PHRASES\"]?.json?.phrasesDb ?? $json.phrasesDb ?? {};\n\n// bgFiles приходят из новых нод\nconst bgFiles = $node[\"FN_PARSE_BGS\"]?.json?.bgFiles ?? [];\nif (!bgFiles.length) throw new Error(\"bgFiles empty (FN_PARSE_BGS)\");\n\nconst requestId = String(req.id ?? session.active_request_id ?? \"\");\nif (!requestId) throw new Error(\"No requestId\");\n\nconst tgUserId = String(session.tg_user_id ?? \"\");\nif (!tgUserId) throw new Error(\"No tg_user_id in session\");\n\nconst recipient = String(req.recipient_name ?? session.recipient_name ?? \"Получатель\");\n\nconst initiatorName = String(\n  session.tg_first_name ??\n  session.first_name ??\n  \"Инициатор\"\n).trim();\n\nconst callback = String(\n  $json.callback_data ??\n  $json.data ??\n  $json.callback?.data ??\n  $json.body?.callback_query?.data ??\n  \"\"\n);\n\n// idx: GEN_FIRST => 1, GEN_NEXT => last+1 (до 3)\nlet idx;\nif (callback === \"GEN_FIRST\") {\n  idx = 1;\n} else {\n  const last = Number(session.last_variant_idx ?? 0);\n  idx = Math.min(last + 1, 3);\n  if (idx < 1) idx = 1;\n}\n\n// Детерминированный seed на вариант: один requestId + idx = один вариант\nconst seed = `${requestId}:v:${idx}`;\n\n// ====== TEMPLATE + LAYOUT ======\nconst template_id = pickTemplateId(requestId, idx);\nconst tpl = TEMPLATE_REGISTRY[template_id];\n\nconst sealPreset = pickDeterministic(tpl.seal_presets, `${seed}:seal`);\nconst stampPreset = pickDeterministic(tpl.stamp_presets, `${seed}:stamp`);\n\n// ФОН: выбираем из ВСЕХ bg*.png, детерминированно для конкретного варианта\nconst bgFile = pickDeterministic(bgFiles, `${seed}:bg`);\n\n// ====== CONTENT FROM phrases.json ======\nconst cat = String(session.category ?? \"universal\");\n\nconst intros = Array.isArray(phrasesDb.intros) && phrasesDb.intros.length\n  ? phrasesDb.intros\n  : [\"Настоящим разрешается:\"];\n\n// интро тоже детерминировано на вариант\nconst intro = pickDeterministic(intros, `${seed}:intro`);\n\n// пул пунктов:\n// 1) берём категорию\n// 2) если не хватает — добиваем universal\n// 3) убираем дубли\nconst pointsPool = buildPointsPool(phrasesDb, cat);\n\nif (!pointsPool.length) {\n  throw new Error(`points pool empty for category=${cat}`);\n}\n\n// пункты: ДОЛЖНО БЫТЬ 8, как в тесте\nconst points = sampleDeterministic(pointsPool, `${seed}:points`, POINTS_COUNT);\n\n// ====== VARIANT ======\nconst variant = {\n  idx,\n  recipient_name: recipient,\n  initiator_name: initiatorName,\n  template_id,\n  bg: bgFile,\n  layout: {\n    seal: {\n      x: sealPreset.x,\n      y: sealPreset.y,\n      rot: sealPreset.rotation,\n      scale: sealPreset.scale,\n      opacity: sealPreset.opacity,\n      color: \"season_pink\"\n    },\n    stamp: {\n      x: stampPreset.x,\n      y: stampPreset.y,\n      rot: stampPreset.rotation,\n      scale: stampPreset.scale,\n      opacity: stampPreset.opacity\n    }\n  },\n  content: { intro, points },\n  meta: {\n    engine_version: ENGINE_VERSION,\n    assets_version: ASSETS_VERSION,\n    created_at: Math.floor(Date.now() / 1000),\n  },\n};\n\nconst variant_json = JSON.stringify(variant);\nconst docNo = `0803-${(simpleHash(seed) % 900) + 100}`;\n\n// ====== PATHS ======\nconst inPath = `${TMP_DIR}/req${requestId}_v${idx}.json`;\nconst outPathLocal = `${OUT_LOCAL_DIR}/req${requestId}_v${idx}.png`;\nconst outPathCloud = `${OUT_CLOUD_DIR}/req${requestId}_v${idx}.png`;\n\n// ====== RENDER JSON ======\nconst renderJson = {\n  mode: \"preview\",\n  templates_dir: TEMPLATES_DIR,\n  bg: bgFile,\n\n  doc_no: docNo,\n  recipient_name: recipient,\n  initiator_name: initiatorName,\n  \n  header_small: \"Специальный выпуск к 8 марта\\nРегламентирующая инстанция «РАЗРЕШЕНО»\",\n  title: \"РАЗРЕШЕНО\",\n  subtitle: `ОФИЦИАЛЬНЫЙ ДОКУМЕНТ № ${docNo}`,\n  intro,\n  points,\n\n  footer_lines: [\"Вступает в силу немедленно.\", \"Обжалованию не подлежит.\"],\n  watermark_lines: [\"Предварительная версия.\", \"Не заверено.\"],\n  source_line: \"Источник оформления: razresheno\",\n\n  qr_url: \"https://t.me/razresheno_buro_bot?start=docqr\",\n  text_block_y: 760,\n\n  layout: variant.layout,\n  output_path: outPathLocal\n};\n\nreturn [{\n  json: {\n    ...$json,\n\n    request_id: requestId,\n    tg_user_id: tgUserId,\n\n    idx,\n    variant,\n    variant_json,\n    variantKey: `razresheno:req:${requestId}:v:${idx}`,\n\n    inPath,\n    outPathLocal,\n    outPathCloud,\n    renderJson,\n\n    session_patch: {\n      current_variant_idx: String(idx),\n      last_variant_idx: String(idx),\n      awaiting: \"none\"\n    }\n  }\n}];"
